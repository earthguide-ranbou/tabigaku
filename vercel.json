{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/henro",
      "destination": "/henro.html"
    },
    {
      "source": "/henro-shinsoku",
      "destination": "/henro-shinsoku.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/award",
      "destination": "/award.html"
    },
    {
      "source": "/sponsor",
      "destination": "/sponsor.html"
    },
    {
      "source": "/thai",
      "destination": "/thai.html"
    },
    {
      "source": "/thai-2027",
      "destination": "/thai-2027.html"
    },
    {
      "source": "/saijai",
      "destination": "/saijai.html"
    },
    {
      "source": "/juku",
      "destination": "/juku.html"
    },
    {
      "source": "/efj",
      "destination": "/efj.html"
    },
    {
      "source": "/earth-family",
      "destination": "/earth-family.html"
    },
    {
      "source": "/earth-family-journey",
      "destination": "/earth-family-journey.html"
    }
  ],
  "headers": [
    {
      "source": "/app-shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/henro.html",
      "destination": "/henro",
      "permanent": true
    },
    {
      "source": "/henro-shinsoku.html",
      "destination": "/henro-shinsoku",
      "permanent": true
    },
    {
      "source": "/guide.html",
      "destination": "/guide",
      "permanent": true
    },
    {
      "source": "/award.html",
      "destination": "/award",
      "permanent": true
    },
    {
      "source": "/sponsor.html",
      "destination": "/sponsor",
      "permanent": true
    },
    {
      "source": "/thai.html",
      "destination": "/thai",
      "permanent": true
    },
    {
      "source": "/thai-2027.html",
      "destination": "/thai-2027",
      "permanent": true
    },
    {
      "source": "/saijai.html",
      "destination": "/saijai",
      "permanent": true
    },
    {
      "source": "/juku.html",
      "destination": "/juku",
      "permanent": true
    },
    {
      "source": "/efj.html",
      "destination": "/efj",
      "permanent": true
    },
    {
      "source": "/earth-family.html",
      "destination": "/earth-family",
      "permanent": true
    },
    {
      "source": "/earth-family-journey.html",
      "destination": "/earth-family-journey",
      "permanent": true
    }
  ]
}
